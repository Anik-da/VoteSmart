{
  "name": "votesmart-india",
  "version": "1.0.0",
  "description": "Bilingual platform for voter awareness in India",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "predev": "node scripts/generate-config.js",
    "dev": "vite",
    "build": "node scripts/generate-config.js && vite build",
    "preview": "vite preview",
