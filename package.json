    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@google/genai": "^1.51.0",
    "firebase": "^12.12.1",
    "firebase-tools": "^15.16.0",
    "vite": "^8.0.10"
  }
}
